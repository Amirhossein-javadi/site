# --- Django Core ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- دیتابیس ---
# sqlite برای توسعه محلی سریع (پیش‌فرض) — postgres هر جا همزمانی واقعی لازم است
DB_ENGINE=sqlite

# فقط اگر DB_ENGINE=postgres باشد استفاده می‌شود
DB_NAME=pos_platform
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# --- CORS: آدرس فرانت React (Vite dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production security (فقط پشت HTTPS واقعی True شود) ---
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
