# --- Django Core ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_TOKEN_TTL_SECONDS=43200
API_THROTTLE_NUM_PROXIES=0

# --- دیتابیس ---
# sqlite برای توسعه محلی سریع (پیش‌فرض) — postgres هر جا همزمانی واقعی لازم است
DB_ENGINE=sqlite

# فقط اگر DB_ENGINE=postgres باشد استفاده می‌شود
DB_NAME=pos_platform
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# اختیاری؛ در محیط غیرتوسعه اگر تنظیم نشود، TLS اجباری است.
# DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60
# فقط در صورت تغییر نام جدول cache اشتراکی
# CACHE_TABLE_NAME=django_cache

# --- CORS: آدرس فرانت React (Vite dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- فقط برای توسعه محلی ---
# برای استقرار، DEBUG=False، کلید تصادفی حداقل ۵۰ نویسه، دامنه‌های واقعی،
# CORS فرانت‌اند و HTTPS را تنظیم کنید. مقادیر نمونه را روی سایت زنده نگذارید.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
