# --- Django Core ---
DJANGO_SECRET_KEY=p1=v1&p2=v2&p3=v3&p4=v4&p5=v5&p6=v6&p7=v7&p8=v8&p9=v9&p10=v10&p11=v11&p12=v12&p13=v13&p14=v14&p15=v15&p16=v16&p17=v17&p18=v18&p19=v19&p20=v20&p21=v21&p22=v22&p23=v23&p24=v24&p25=v25&p26=v26&p27=v27&p28=v28&p29=v29&p30=v30&p31=v31&p32=v32&p33=v33&p34=v34&p35=v35&p36=v36&p37=v37&p38=v38&p39=v39&p40=v40&p41=v41&p42=v42&p43=v43&p44=v44&p45=v45&p46=v46&p47=v47&p48=v48&p49=v49&p50=v50
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_TOKEN_TTL_SECONDS=43200
API_THROTTLE_NUM_PROXIES=0

# --- دیتابیس ---
# sqlite برای توسعه محلی سریع (پیش‌فرض) — postgres هر جا همزمانی واقعی لازم است
DB_ENGINE=sqlite

# فقط اگر DB_ENGINE=postgres باشد استفاده می‌شود
DB_NAME=pos_platform
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# اختیاری؛ در محیط غیرتوسعه اگر تنظیم نشود، TLS اجباری است.
# DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60
# فقط در صورت تغییر نام جدول cache اشتراکی
# CACHE_TABLE_NAME=django_cache

# --- CORS: آدرس فرانت React (Vite dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- فقط برای توسعه محلی ---
# برای استقرار، DEBUG=False، کلید تصادفی حداقل ۵۰ نویسه، دامنه‌های واقعی،
# CORS فرانت‌اند و HTTPS را تنظیم کنید. مقادیر نمونه را روی سایت زنده نگذارید.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
